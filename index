    // Export: [data-lpm="price"]  |  Preview: same
    var priceEl = document.querySelector('[data-lpm="price"]');
    if (priceEl) {
      var raw = priceEl.textContent.replace(/[^0-9]/g, '');
      var num = parseInt(raw);
      if (num > 0) {
