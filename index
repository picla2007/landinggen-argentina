<script>
(function(){
  var TIERS = [{"limit":300,"price":"117000"},{"limit":500,"price":"245000"},{"limit":700,"price":"570000"},{"limit":900,"price":"790000"}];
  var buyers = 84;
  var intervalSecs = 15;
  var timerSecs = 47 * 60;
  var currentTierIdx = 0;

  function getBuyerIncrease() {
    return Math.floor(Math.random() * 3) + 1;
  }

  function getCurrentTier() {
    for (var i = 0; i < TIERS.length; i++) {
      if (buyers <= TIERS[i].limit) return i;
    }
    return TIERS.length - 1;
  }

  function renderTiers() {
    var list = document.getElementById('pt-tiers-list');
    if (!list) return;
    currentTierIdx = getCurrentTier();
    var html = '';
    TIERS.forEach(function(t, i) {
      var cls = i < currentTierIdx ? 'pt-done' : i === currentTierIdx ? 'pt-current' : 'pt-next';
      var badge = i < currentTierIdx ? 'Superado' : i === currentTierIdx ? 'Activo ✓' : 'Próximo';
      var prevLimit = i === 0 ? 0 : TIERS[i-1].limit;
      html += '<div class="pt-level ' + cls + '">'
        + '<div class="pt-level-dot"></div>'
        + '<div class="pt-level-info">'
        +   '<div class="pt-level-range">' + (prevLimit+1) + '–' + t.limit + ' compradores</div>'
        +   '<div class="pt-level-price">$' + t.price + '</div>'
        + '</div>'
        + '<span class="pt-level-badge">' + badge + '</span>'
        + '</div>';
    });
    list.innerHTML = html;

    // progress bar within current tier
    var prevLimit = currentTierIdx === 0 ? 0 : TIERS[currentTierIdx-1].limit;
    var tierRange = TIERS[currentTierIdx].limit - prevLimit;
    var progress = Math.min(((buyers - prevLimit) / tierRange) * 100, 100);
    var fill = document.getElementById('pt-progress-fill');
    if (fill) fill.style.width = progress + '%';
  }

  function updateBuyers() {
    buyers += getBuyerIncrease();
    var el = document.getElementById('pt-buyers-txt');
    if (el) el.textContent = buyers + ' personas compraron hoy';
    renderTiers();
  }

  function updateTimer() {
    if (timerSecs <= 0) {
      // Advance to next tier
      if (currentTierIdx < TIERS.length - 1) {
        buyers = TIERS[currentTierIdx].limit + 1;
        timerSecs = 47 * 60;
        renderTiers();
        // Flash the widget
        var w = document.getElementById('pt-widget');
        if (w) { w.style.transform = 'scale(1.04)'; setTimeout(function(){ w.style.transform=''; }, 300); }
      }
      return;
    }
    timerSecs--;
    var h = Math.floor(timerSecs / 3600);
    var m = Math.floor((timerSecs % 3600) / 60);
    var s = timerSecs % 60;
    var fmt = (h > 0 ? String(h).padStart(2,'0') + ':' : '') +
              String(m).padStart(2,'0') + ':' +
              String(s).padStart(2,'0');
    var el = document.getElementById('pt-timer');
    if (el) el.textContent = fmt;
  }

  // Init
  renderTiers();
  setInterval(updateTimer, 1000);
  setInterval(updateBuyers, intervalSecs * 1000);
})();
</script>

